# Clerk
# Create an application at https://dashboard.clerk.com and copy these keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Apex routes used by Clerk redirects and modal fallbacks.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/account
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Object storage
# Defaults to local filesystem storage under data/object-storage.
# Set to "s3" after implementing credentials and bucket config in the S3 adapter.
APEX_OBJECT_STORAGE_DRIVER=local
